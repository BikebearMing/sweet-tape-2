# Copy to .env.local and fill in before using /admin.
#
# The front end does NOT need either of these — the tape content is local
# (src/data/tapes.ts) until the CMS is wired up. Only /admin and /api/* touch
# the database.

# Neon Postgres. Neon requires SSL, hence sslmode=require.
DATABASE_URI=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Any long random string. Signs Payload's auth cookies — changing it logs
# everyone out.
PAYLOAD_SECRET=change-me-to-something-long-and-random
